# Copy this file to .env and it is read on start by `npm run case`, `npm run
# serve` and `npm run eval:replies`. Anything already set in your shell wins
# over the file. A blank value means "use the default".

# ---------------------------------------------------------------------------
# Which backend reads the emails.
#
#   claude-code   the local Claude Code CLI, on whatever auth it already has.
#                 No API key. Development and end-to-end testing.
#   anthropic     the Anthropic API, with a key. Production.
#   fixture       replays labelled extractions. Offline, free, deterministic.
#                 What the tests and CI use.
#
# Leave it unset and we take `anthropic` when ANTHROPIC_API_KEY is present and
# `claude-code` otherwise, which is right in both places.
# ---------------------------------------------------------------------------
EXTRACT_PROVIDER=

# Only for EXTRACT_PROVIDER=anthropic. Never commit a real key.
ANTHROPIC_API_KEY=

# Model per provider. The API wants a full id, the CLI takes an alias.
EXTRACT_MODEL=claude-sonnet-5-5
EXTRACT_MODEL_LOCAL=sonnet

# How many emails to read at once. The CLI spawns a process per call, so it
# defaults lower (4) than the API (6).
EXTRACT_CONCURRENCY=

# claude-code only.
CLAUDE_CODE_BIN=claude
EXTRACT_TIMEOUT_MS=120000
# Passed to the CLI as --max-budget-usd. A seatbelt for a long eval run.
EXTRACT_MAX_BUDGET_USD=

# Print provider, latency and cost for every model call.
EXTRACT_LOG=0

# Fail on a malformed model response instead of retrying once.
STRICT_EXTRACTION=0

# HTTP port for the local service.
PORT=3000
