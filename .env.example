# Anthropic API key. Issued by Athos with a monthly spending cap.
# Never commit a real key; copy this file to .env and fill it in.
ANTHROPIC_API_KEY=

# Model used to read replies (M3). Extraction only - never decisions.
EXTRACT_MODEL=claude-sonnet-5-5

# Model used for research-packet synthesis (M4).
RESEARCH_MODEL=claude-sonnet-5-5

# HTTP port for the local service.
PORT=3000

# Set to "1" to fail fast instead of retrying a malformed model response.
STRICT_EXTRACTION=0
