{
  "name": "needs-review-agent",
  "version": "0.1.0",
  "private": true,
  "description": "1st-layer Needs Review agent for Athos Inland Marine applications. One JSON case packet in, one JSON result out.",
  "license": "UNLICENSED",
  "engines": { "node": ">=20" },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "eval": "tsx eval/run.ts",
    "eval:replies": "tsx eval/run.ts --replies",
    "case": "tsx src/cli.ts",
    "serve": "tsx src/server.ts",
    "serve:prod": "node dist/server.js",
    "schema": "tsx scripts/emit-schema.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "express": "^5.1.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.9.1",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
