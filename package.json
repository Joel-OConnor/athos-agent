{
  "name": "needs-review-agent",
  "version": "0.1.0",
  "private": true,
  "description": "1st-layer Needs Review agent for Athos Inland Marine applications. One JSON case packet in, one JSON result out.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test:coverage && npm run eval && npm run schema:check",
    "eval": "tsx eval/run.ts",
    "eval:replies": "tsx eval/run.ts --replies",
    "case": "tsx src/cli.ts",
    "serve": "tsx src/server.ts",
    "start": "node dist/server.js",
    "schema": "tsx scripts/emit-schema.ts",
    "schema:check": "tsx scripts/emit-schema.ts --check"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "express": "^5.1.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.9.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "jest": "^30.2.0",
    "prettier": "^3.9.10",
    "ts-jest": "^29.4.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
